{
  "image": "mcr.microsoft.com/devcontainers/base:ubuntu",
  "hostRequirements": {
    "cpus": 4,
    "memory": "16gb",
    "storage": "32gb"
  },
  "features": {
    "ghcr.io/devcontainers/features/docker-in-docker:2": {}
  },
  "forwardPorts": [8006, 5900],
  "portsAttributes": {
    "8006": {
      "label": "macOS Viewer",
      "onAutoForward": "openBrowser"
    },
    "5900": {
      "label": "VNC"
    }
  }
}
